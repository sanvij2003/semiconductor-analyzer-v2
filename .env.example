# Copy this file to .env and paste your Finviz Elite API token after the = sign.
# .env is in .gitignore, so it never reaches GitHub.
FINVIZ_API_KEY=

# Optional: a different screener export URL. Keep the placeholder, never a real key.
# FINVIZ_EXPORT_URL=https://elite.finviz.com/export.ashx?v=152&f=...&c=...&auth={FINVIZ_API_KEY}
